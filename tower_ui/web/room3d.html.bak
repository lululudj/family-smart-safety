<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>全屋三维模型 · 家庭安全调度系统</title>
<style>
  :root{
    --bg:#0b0f14; --panel:rgba(18,24,33,.86); --line:rgba(120,160,200,.18);
    --txt:#e7eef7; --dim:#8ba0b8; --acc:#4da3ff;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--txt);
    font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;overflow:hidden}
  #app{position:fixed;inset:0}
  canvas{display:block}

  .panel{position:absolute;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;backdrop-filter:blur(12px);padding:14px 16px}

  #info{top:16px;left:16px;min-width:232px}
  #info h1{margin:0 0 2px;font-size:15px;font-weight:600;letter-spacing:.3px}
  #info .sub{color:var(--dim);font-size:11px;margin-bottom:10px}
  .kv{display:flex;justify-content:space-between;font-size:12px;padding:3px 0;
    border-bottom:1px dashed rgba(120,160,200,.10)}
  .kv:last-child{border-bottom:none}
  .kv span:first-child{color:var(--dim)}
  .kv span:last-child{font-variant-numeric:tabular-nums;color:var(--txt)}

  #ctl{bottom:16px;left:16px;display:flex;flex-wrap:wrap;gap:8px;max-width:min(560px,90vw)}
  button{background:rgba(77,163,255,.10);border:1px solid rgba(77,163,255,.32);
    color:var(--txt);padding:8px 13px;border-radius:9px;font-size:12.5px;cursor:pointer;
    transition:background .15s,border-color .15s}
  button:hover{background:rgba(77,163,255,.20)}
  button.off{background:transparent;border-color:rgba(120,160,200,.22);color:var(--dim)}

  #hint{position:absolute;bottom:18px;right:18px;color:var(--dim);font-size:11px;
    text-align:right;line-height:1.6}
  #stat{position:absolute;top:16px;right:16px;font-size:11.5px;color:var(--dim)}
  #stat b{color:var(--acc);font-weight:600}
  #err{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    color:#ff8090;font-size:13px;display:none;text-align:center;line-height:1.7}
</style>
</head>
<body>
<div id="app"></div>

<div class="panel" id="info">
  <h1>全屋三维模型</h1>
  <div class="sub">Kinect v2 新扫描 · AI 4× 超分增强</div>
  <div class="kv"><span>房间尺寸</span><span>4.42 × 3.11 m</span></div>
  <div class="kv"><span>占地</span><span>13.7 m²</span></div>
  <div class="kv"><span>层高</span><span>3.61 m</span></div>
  <div class="kv"><span>扫描点</span><span>3,614,853</span></div>
  <div class="kv"><span>内部点云</span><span>450,000</span></div>
  <div class="kv"><span>壳体三角面</span><span>12</span></div>
  <div class="kv"><span>贴图分辨率</span><span>4096 px（AI 超分）</span></div>
</div>

<div class="panel" id="ctl">
  <button id="bRoof">天花板</button>
  <button id="bInner">家具点云</button>
  <button id="bWall">墙体</button>
  <button id="bFlat">平面模式</button>
  <button id="bReset">重置视角</button>
</div>

<div id="stat">FPS <b id="fps">--</b> · 拖拽旋转 · 滚轮缩放 · 右键平移</div>
<div id="hint">左键拖拽 = 旋转<br>滚轮 = 缩放<br>右键拖拽 = 平移</div>
<div id="err">模型加载失败<br><span id="errmsg"></span></div>

<script>
// surface any failure (module load, texture decode, WebGL) on screen
(function () {
  function show(msg) {
    var el = document.getElementById('err');
    var m = document.getElementById('errmsg');
    if (!el || !m || el.style.display === 'block') return;
    el.style.display = 'block';
    m.textContent = String(msg).slice(0, 300);
  }
  window.addEventListener('error', function (e) {
    show((e.message || 'script error') + (e.filename ? ' @ ' + e.filename.split('/').pop() : ''));
  }, true);
  window.addEventListener('unhandledrejection', function (e) {
    show('Promise: ' + ((e.reason && (e.reason.message || e.reason)) || 'unknown'));
  });
  window.__roomBoot = 'html-parsed';
})();
</script>

<script type="importmap">
{
  "imports": {
    "three": "./vendor/three.module.js",
    "three/addons/": "./vendor/jsm/"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

// proves the ES module executed (a black canvas alone cannot tell us this)
document.getElementById('stat').innerHTML =
  'three.js r' + THREE.REVISION + ' 已加载 · 拖拽旋转 · 滚轮缩放 · 右键平移 · FPS <b id="fps">--</b>';

const app = document.getElementById('app');
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0b0f14);
scene.fog = new THREE.Fog(0x0b0f14, 14, 34);

const camera = new THREE.PerspectiveCamera(48, innerWidth/innerHeight, 0.05, 200);
camera.position.set(6.5, 5.2, 7.5);

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.outputColorSpace = THREE.SRGBColorSpace;
app.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.06;
controls.maxPolarAngle = Math.PI * 0.495;   // stay above the floor
controls.minDistance = 1.0;
controls.maxDistance = 40;
controls.target.set(0, 1.3, 0);

// ---------------------------------------------------------------- lights
scene.add(new THREE.HemisphereLight(0xcfe3ff, 0x1a2028, 1.15));
const key = new THREE.DirectionalLight(0xffffff, 1.5);
key.position.set(6, 11, 7); scene.add(key);
const fill = new THREE.DirectionalLight(0xbcd4ff, 0.65);
fill.position.set(-7, 5, -6); scene.add(fill);
const rim = new THREE.DirectionalLight(0xffffff, 0.4);
rim.position.set(0, -5, 4); scene.add(rim);

// ---------------------------------------------------------------- ground grid
const grid = new THREE.GridHelper(24, 48, 0x2a3a4d, 0x18222d);
grid.position.y = -0.01;
scene.add(grid);

// ---------------------------------------------------------------- load model
const groups = { shell:{}, points:{} };
let model = null;
const bRoof = document.getElementById('bRoof');
const bInner = document.getElementById('bInner');
const bWall = document.getElementById('bWall');
const bFlat = document.getElementById('bFlat');

const loader = new GLTFLoader();
loader.load('room_model_v4.glb?v=4sr', (gltf) => {
  model = gltf.scene;
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  model.traverse(o => {
    if (!o.isMesh && !o.isPoints) return;
    const isPoints = o.isPoints;
    o.userData.role = o.name === 'Interior' ? 'inner'
                    : o.name === 'Ceiling'   ? 'roof' : 'wall';
    if (isPoints) {
      o.material.size = 0.022;
      o.material.sizeAttenuation = true;
      o.material.vertexColors = true;
      o.material.transparent = true;
      o.material.opacity = 0.95;
      groups.points[o.uuid] = o;
    } else {
      o.material.side = THREE.DoubleSide;
      o.material.roughness = 0.92;
      o.material.metalness = 0.0;
      // keep the 4096px AI-upscaled textures crisp at grazing angles
      const map = o.material.map;
      if (map) {
        map.anisotropy = maxAniso;
        map.minFilter = THREE.LinearMipmapLinearFilter;
        map.magFilter = THREE.LinearFilter;
        map.generateMipmaps = true;
        map.needsUpdate = true;
      }
      groups.shell[o.uuid] = o;
    }
  });
  scene.add(model);

  // frame the model
  const box = new THREE.Box3().setFromObject(model);
  const c = box.getCenter(new THREE.Vector3());
  const s = box.getSize(new THREE.Vector3());
  const r = Math.max(s.x, s.y, s.z);
  controls.target.set(c.x, c.y * 0.72, c.z);
  camera.position.set(c.x + r * 0.95, c.y + r * 0.85, c.z + r * 1.05);
  controls.update();
  camera.near = r / 200; camera.far = r * 40; camera.updateProjectionMatrix();

  applyVisibility();
  // debug handle for runtime diagnosis
  window.__room = { groups, state, applyVisibility, sync, model };
}, undefined, (e) => {
  document.getElementById('err').style.display = 'block';
  document.getElementById('errmsg').textContent = String(e && e.message || e);
});

// ---------------------------------------------------------------- toggles
const state = { roof:true, inner:true, wall:true, flat:false };
function applyVisibility(){
  for (const o of Object.values(groups.shell)) {
    const role = o.userData.role;
    o.visible = (role === 'roof') ? state.roof : state.wall;
  }
  for (const o of Object.values(groups.points)) o.visible = state.inner;
}
function sync(){
  bRoof.classList.toggle('off', !state.roof);
  bInner.classList.toggle('off', !state.inner);
  bWall.classList.toggle('off', !state.wall);
  bFlat.classList.toggle('off', !state.flat);
  applyVisibility();
}
bRoof.onclick  = () => { state.roof  = !state.roof;  sync(); };
bInner.onclick = () => { state.inner = !state.inner; sync(); };
bWall.onclick  = () => { state.wall  = !state.wall;  sync(); };
bFlat.onclick  = () => {
  state.flat = !state.flat;
  for (const o of Object.values(groups.shell)) {
    if (o.userData.role === 'wall') {
      o.material.flatShading = state.flat;
      o.material.needsUpdate = true;
    }
  }
  sync();
};
document.getElementById('bReset').onclick = () => {
  if (!model) return;
  const box = new THREE.Box3().setFromObject(model);
  const c = box.getCenter(new THREE.Vector3());
  const s = box.getSize(new THREE.Vector3());
  const r = Math.max(s.x, s.y, s.z);
  controls.target.set(c.x, c.y * 0.72, c.z);
  camera.position.set(c.x + r * 0.95, c.y + r * 0.85, c.z + r * 1.05);
  controls.update();
};
sync();

// ---------------------------------------------------------------- loop
addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

let last = performance.now(), frames = 0;
const fpsEl = document.getElementById('fps');
function tick(now){
  requestAnimationFrame(tick);
  controls.update();
  renderer.render(scene, camera);
  frames++;
  if (now - last > 500) {
    fpsEl.textContent = Math.round(frames * 1000 / (now - last));
    frames = 0; last = now;
  }
}
requestAnimationFrame(tick);
</script>
</body>
</html>
